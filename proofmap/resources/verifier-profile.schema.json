{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofmap:verifier-profile:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "id",
    "name",
    "toolchain",
    "imports",
    "axioms",
    "executable",
    "search_path",
    "image",
    "platform",
    "lean_sha256",
    "library_digest",
    "checker_digest",
    "acquisition_digest",
    "limits"
  ],
  "properties": {
    "record_type": {
      "const": "VerifierProfile"
    },
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "name": {
      "const": "lean-std-int-polynomial-v1"
    },
    "toolchain": {
      "const": "leanprover/lean4:v4.30.0"
    },
    "imports": {
      "const": [
        "Std"
      ]
    },
    "axioms": {
      "const": [
        "Classical.choice",
        "Quot.sound",
        "propext"
      ]
    },
    "executable": {
      "const": "/opt/lean/bin/lean"
    },
    "search_path": {
      "const": "/opt/lean/lib/lean"
    },
    "image": {
      "type": "string",
      "pattern": "^(sha256:[a-f0-9]{64}|[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64})$"
    },
    "platform": {
      "enum": [
        "linux/amd64",
        "linux/arm64"
      ]
    },
    "lean_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "library_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checker_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acquisition_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds",
        "memory_mb",
        "cpus",
        "pids",
        "output_bytes",
        "temp_mb"
      ],
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "cpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "pids": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000000
        },
        "temp_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      }
    }
  }
}
