{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofmap:paper-input:1",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "revision", "entrypoint", "artifacts"],
  "properties": {
    "$schema": {"const": "urn:proofmap:paper-input:1"}, "schema_version": {"const": "1.0"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entrypoint": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 256, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"],
      "properties": {"path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size": {"type": "integer", "minimum": 0, "maximum": 4000000}}
    }}
  }
}
