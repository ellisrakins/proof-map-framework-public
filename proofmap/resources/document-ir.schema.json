{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofmap:document-ir:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "revision",
    "parser",
    "elements",
    "scopes",
    "references",
    "findings",
    "fidelity",
    "status"
  ],
  "properties": {
    "$schema": {
      "const": "urn:proofmap:document-ir:1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "revision": {
      "type": "string"
    },
    "parser": {
      "type": "object"
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "revision",
          "kind",
          "scope",
          "text",
          "locator",
          "labels",
          "references",
          "citations",
          "proof_for",
          "quality",
          "math_ast"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "ASSERTION",
              "PROOF",
              "EQUATION",
              "UNSUPPORTED_ENVIRONMENT",
              "PROSE",
              "ENVIRONMENT_DEFINITION",
              "MACRO_DEFINITION",
              "SECTION",
              "LABEL",
              "CITATION",
              "REFERENCE",
              "BIBLIOGRAPHIC_REFERENCE",
              "BIBLIOGRAPHY",
              "UNSUPPORTED_MACRO",
              "SYMBOL_OCCURRENCE",
              "MATH_EXPRESSION",
              "UNPARSED_SOURCE",
              "PDF_PAGE_TEXT"
            ]
          },
          "scope": {
            "type": "string"
          },
          "lexical_scope": {"type": "string", "minLength": 1},
          "declaration": {"$ref": "#/$defs/declaration"},
          "binding_status": {"enum": ["RESOLVED", "UNRESOLVED"]},
          "binding_reason": {"type": ["string", "null"]},
          "text": {
            "type": "string"
          },
          "locator": {
            "type": "object"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proof_for": {
            "type": [
              "string",
              "null"
            ]
          },
          "proof_association": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "method", "candidate_targets", "reference_keys", "external_keys"],
            "properties": {
              "status": {"enum": ["RESOLVED", "AMBIGUOUS", "UNRESOLVED", "EXTERNAL"]},
              "method": {"enum": ["ADJACENT", "EXPLICIT", "EXTERNAL", "NONE"]},
              "candidate_targets": {"$ref": "#/$defs/ids"},
              "reference_keys": {"$ref": "#/$defs/ids"},
              "external_keys": {"$ref": "#/$defs/ids"}
            }
          },
          "quality": {
            "type": "string"
          },
          "math_ast": {
            "type": "null"
          },
          "environment": {
            "type": "string"
          },
          "role": {
            "enum": ["THEOREM", "LEMMA", "PROPOSITION", "COROLLARY", "CONJECTURE", "DEFINITION", "ASSUMPTION", "EXAMPLE", "REMARK", "UNRESOLVED"]
          },
          "environment_declaration": {"type": "string"},
          "owner": {"type": "string"},
          "context_dependencies": {"type": "array", "items": {"type": "string"}},
          "key": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          }
        }
      },
      "maxItems": 20000
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lexical_scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {"$ref": "#/$defs/lexical_scope"}
    },
    "mathematical_context": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/mathematical_context"}},
    "source_inferences": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/source_inference"}},
    "references": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["element", "owner", "key", "kind", "targets"],
        "properties": {
          "element": {"type": "string", "minLength": 1},
          "owner": {"type": ["string", "null"], "minLength": 1},
          "key": {"type": "string", "minLength": 1},
          "kind": {"enum": ["REFERENCE", "CITATION"]},
          "targets": {"$ref": "#/$defs/ids"},
          "purpose": {"enum": ["SOURCE_REFERENCE", "BIBLIOGRAPHIC_CITATION", "PROOF_ASSOCIATION"]}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fidelity": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "PARTIAL"
      ]
    },
    "included": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "ids": {"type": "array", "maxItems": 20000, "items": {"type": "string", "minLength": 1}},
    "mathematical_context": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "kind", "owner", "scope", "source_locators", "text", "status", "variable", "domain"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "kind": {"enum": ["VARIABLE_BINDER", "THEOREM_ANTECEDENT", "LOCAL_PROOF_HYPOTHESIS", "AUTHOR_DEFINITION", "RESEARCH_ASSUMPTION", "IMPORTED_CLAIM"]},
        "owner": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "source_locators": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/lexical_locator"}},
        "text": {"type": "string"},
        "status": {"enum": ["SOURCE_PARSED", "CANDIDATE"]},
        "variable": {"type": ["string", "null"], "pattern": "^[a-z]$"},
        "domain": {"enum": ["Int", null]}
      }
    },
    "source_inference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "conclusion", "premises", "alternative_group", "source_ids", "source_locators", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "conclusion": {"type": "string", "minLength": 1},
        "premises": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "alternative_group": {"type": "string", "minLength": 1},
        "source_ids": {"$ref": "#/$defs/ids"},
        "source_locators": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/lexical_locator"}},
        "status": {"const": "AUTHOR_ASSERTED_UNVERIFIED"}
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "symbol", "parameter_count", "optional_default", "replacement", "replacement_tokens", "binding_status", "previous_definition", "resolution"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "symbol": {"type": ["string", "null"], "minLength": 1},
        "parameter_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 9},
        "optional_default": {"type": ["string", "null"]},
        "replacement": {"type": ["string", "null"]},
        "replacement_tokens": {"type": "array", "maxItems": 20000, "items": {"type": "string", "minLength": 1}},
        "binding_status": {"enum": ["DEFINED", "REDEFINED", "PRESERVED", "INVALID", "UNSUPPORTED"]},
        "previous_definition": {"type": ["string", "null"], "minLength": 1},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    },
    "lexical_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parent", "kind", "name", "locator", "resolution", "reasons"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "parent": {"type": ["string", "null"], "minLength": 1},
        "kind": {"enum": ["ROOT", "GROUP", "ENVIRONMENT"]},
        "name": {"type": ["string", "null"], "minLength": 1},
        "locator": {"anyOf": [{"$ref": "#/$defs/lexical_locator"}, {"type": "null"}]},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "reasons": {"type": "array", "maxItems": 20000, "items": {"type": "string", "minLength": 1}}
      }
    },
    "lexical_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "artifact_sha256", "format", "start", "end", "page", "excerpt_sha256", "offsets"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "format": {"const": "tex"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "page": {"type": "null"},
        "excerpt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "offsets": {"const": "utf8-bytes-half-open"},
        "text_start": {"type": "null"},
        "text_end": {"type": "null"},
        "parser_version": {"type": "null"}
      }
    }
  }
}
