                                  "linux/arm64"
                                ]
                              },
                              "executable": {
                                "const": "/opt/lean/bin/lean"
                              },
                              "search_path": {
                                "const": "/opt/lean/lib/lean"
                              },
                              "image": {
                                "type": "string",
                                "pattern": "^(sha256:[a-f0-9]{64}|[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64})$"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "outcome": {
                  "enum": [
                    "VERIFIED",
                    "COMPILER_REJECTED",
                    "UNAVAILABLE",
                    "ERROR",
                    "TIMEOUT",
                    "VERIFIER_ERROR"
                  ]
                },
                "compiler_outcome": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "NOT_RUN"
                  ]
                },
                "checker_outcome": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "NOT_RUN"
                  ]
                },
                "axioms": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "uniqueItems": true
                },
                "outputs": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "worker_stdout",
                    "worker_stderr",
                    "candidate_source"
                  ],
                  "properties": {
                    "worker_stdout": {
                      "type": "string",
                      "maxLength": 1000000
                    },
                    "worker_stderr": {
                      "type": "string",
                      "maxLength": 1000000
                    },
                    "candidate_source": {
                      "type": "string",
                      "maxLength": 1000000
                    }
                  }
                },
                "output_digests": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "worker_stdout",
                    "worker_stderr",
                    "candidate_source"
                  ],
                  "properties": {
                    "worker_stdout": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "worker_stderr": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "candidate_source": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                },
                "duration_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "assurance": {
                  "const": "TRUSTED_RESTRICTED_SOURCE_KERNEL_RECHECK"
                }
              }
            },
            "envelope": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "required": [
            "event",
            "envelope"
          ]
        }
      },
      "required": [
        "parent_run_id",
        "parent_revision",
        "binding",
        "obligation",
        "execution"
      ]
    }
  },
  "required": [
    "schema_version",
    "assertion_id",
    "revision",
    "method",
    "status",
    "reason",
    "context_digest",
    "definition_digest",
    "source_locators",
    "fidelity"
  ],
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "int",
            "var",
            "group",
            "neg",
            "pos",
            "pow",
            "add",
            "sub",
            "mul"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z]$"
        },
        "exponent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "child": {
          "$ref": "#/$defs/node"
        },
        "left": {
          "$ref": "#/$defs/node"
        },
        "right": {
          "$ref": "#/$defs/node"
        }
      },
      "required": [
        "op",
        "start",
        "end"
      ]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "excerpt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "offsets": {
          "const": "utf8-bytes-half-open"
        }
      },
      "required": [
        "artifact",
        "start",
        "end",
        "excerpt_sha256",
        "offsets"
      ]
    },
    "locator": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:proofmap:source-locator:1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "artifact_sha256",
        "format",
        "start",
        "end",
        "page",
        "excerpt_sha256",
        "offsets"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "enum": [
            "tex",
            "pdf"
          ]
        },
        "start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "excerpt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "offsets": {
          "enum": [
            "utf8-bytes-half-open",
            "reconstructed-text-no-source-offsets"
          ]
        },
        "text_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "text_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "parser_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUPPORTED"
          }
        }
      },
      "then": {
        "required": [
          "source_ast",
          "source_spans",
          "obligation",
          "candidate",
          "exact_check"
        ],
        "properties": {
          "reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "source_ast"
              ]
            },
            {
              "required": [
                "obligation"
              ]
            },
            {
              "required": [
                "candidate"
              ]
            },
            {
              "required": [
                "binding"
              ]
            },
            {
              "required": [
                "exact_check"
              ]
            },
            {
              "required": [
                "execution_event"
              ]
            },
            {
              "required": [
                "historical_execution"
              ]
            }
          ]
        }
      }
    }
  ]
}
