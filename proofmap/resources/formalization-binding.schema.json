{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "id",
    "revision_id",
    "assertion_id",
    "assertion_digest",
    "source_locators",
    "context_digest",
    "definition_digest",
    "obligation_digest",
    "method",
    "candidate_digest"
  ],
  "properties": {
    "record_type": {
      "const": "FormalizationBinding"
    },
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assertion_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "assertion_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_locators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "urn:proofmap:source-locator:1",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact",
              "artifact_sha256",
              "format",
              "start",
              "end",
              "page",
              "excerpt_sha256",
              "offsets"
            ],
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "format": {
                "enum": [
                  "tex",
                  "pdf"
                ]
              },
              "start": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "end": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "excerpt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "offsets": {
                "enum": [
                  "utf8-bytes-half-open",
                  "reconstructed-text-no-source-offsets"
                ]
              },
              "text_start": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "text_end": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "parser_version": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "start",
              "end"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ]
      }
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "definition_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "obligation_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
