{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofmap:extractor-config:1",
  "type": "object", "additionalProperties": false,
  "required": ["provider", "endpoint", "model", "timeout_seconds", "max_output_tokens"],
  "properties": {
    "provider": {"const": "ollama"},
    "endpoint": {"type": "string", "minLength": 1, "maxLength": 4096},
    "model": {"type": "string", "minLength": 1, "maxLength": 512},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
    "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 4096},
    "stage": {"enum": ["classification", "decomposition", "candidate-fidelity"]},
    "max_requests": {"type": "integer", "minimum": 1, "maximum": 64},
    "max_input_bytes": {"type": "integer", "minimum": 1, "maximum": 4000000},
    "max_total_output_tokens": {"type": "integer", "minimum": 1, "maximum": 65536},
    "max_total_seconds": {"type": "integer", "minimum": 1, "maximum": 120}
  }
}
