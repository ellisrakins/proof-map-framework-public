{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofmap:interpretation-override:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "record_type", "revision", "run_id", "analysis_digest", "policy_digest", "raw_ir_digest", "extraction_digest", "prior_overrides_digest", "author", "attribution_authenticated", "created_at", "targets", "changes"],
  "properties": {
    "id": {"$ref": "#/$defs/digest"},
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "InterpretationOverride"},
    "revision": {"$ref": "#/$defs/digest"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "analysis_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "raw_ir_digest": {"$ref": "#/$defs/digest"},
    "extraction_digest": {"$ref": "#/$defs/digest"},
    "prior_overrides_digest": {"$ref": "#/$defs/digest"},
    "author": {"type": "string", "minLength": 1, "maxLength": 512},
    "attribution_authenticated": {"const": false},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "targets": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/target"}},
    "changes": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/change"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "scope", "source_digest"],
      "properties": {
        "id": {"$ref": "#/$defs/digest"},
        "kind": {"enum": ["ASSERTION", "PROOF"]},
        "scope": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target", "scope", "source_digest", "value", "note"],
      "properties": {
        "kind": {"enum": ["role", "proof_for", "dependencies"]},
        "target": {"$ref": "#/$defs/digest"},
        "scope": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source_digest": {"$ref": "#/$defs/digest"},
        "value": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 64}, {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}]},
        "note": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
