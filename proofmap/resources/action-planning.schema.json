          "pattern": "^[0-9a-f]{64}$"
        },
        "action_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "attribution_authenticated": {
          "const": false
        },
        "requested_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "status": {
          "const": "REQUESTED"
        },
        "execution": {
          "const": "NOT_RUN"
        },
        "event_ids": {
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "schema_version",
        "id",
        "authority",
        "kind",
        "plan_id",
        "subject_digest",
        "action_id",
        "actor",
        "attribution_authenticated",
        "requested_at",
        "status",
        "execution",
        "event_ids"
      ]
    }
  }
}
