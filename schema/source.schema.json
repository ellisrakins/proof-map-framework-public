{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/proofmap.source.schema.json",
  "title": "Proof Map Source Registry",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "source_type", "checked_date"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "url": {"type": "string"},
          "source_type": {"type": "string"},
          "publisher": {"type": "string"},
          "publication_date": {"type": "string"},
          "checked_date": {"type": "string"},
          "notes": {"type": "string"},
          "domains": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
