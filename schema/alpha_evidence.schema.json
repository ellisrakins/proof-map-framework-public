{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofmap:alpha-evidence:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tested_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "git_tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pr_head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "run_attempt": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "package_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "tested_commit",
        "git_tree",
        "source_fingerprint",
        "pr_head",
        "run_id",
        "run_attempt",
        "package_version",
        "manifest_sha256"
      ]
    },
    "job": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "kind": {
      "enum": [
        "pytest",
        "command"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "tests": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeid",
          "outcome"
        ],
        "properties": {
          "nodeid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "xfailed",
              "xpassed",
              "error"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "identity",
    "job",
    "profile",
    "kind",
    "status",
    "exit_code",
    "tests",
    "artifacts"
  ]
}
