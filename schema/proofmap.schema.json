{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/proofmap.schema.json",
  "title": "Proof Map Boundary Analysis Graph",
  "type": "object",
  "required": ["title", "nodes", "edges"],
  "properties": {
    "title": {"type": "string"},
    "description": {"type": "string"},
    "metadata": {"type": "object"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "status", "layer"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "kind": {"enum": ["AXIOM", "PRIMITIVE_LAW", "DEFINITION", "THEOREM", "MODEL", "REGIME", "INTERFACE", "BRIDGE", "CONSTANT", "OBSERVATION", "PHENOMENON", "UNCERTAINTY", "GAP", "FLOW"]},
          "status": {"enum": ["CORE", "PROVED", "DERIVED", "COMPUTED", "EMPIRICAL", "PROBABILISTIC", "ASSUMPTION", "APPROXIMATION", "GAP", "BLOCKED", "EXTERNAL", "INDEPENDENT"]},
          "layer": {"enum": ["CORE", "INTERIOR", "BOUNDARY", "EXTERIOR"]},
          "domain": {"type": "string"},
          "explanatory_weight": {"type": "number", "minimum": 0},
          "proof_cost": {"type": "number", "minimum": 0},
          "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
          "boundary_weight": {"type": "number", "minimum": 0},
          "epoch_start": {"type": ["number", "null"]},
          "epoch_end": {"type": ["number", "null"]},
          "energy_scale_gev": {"type": ["number", "null"]},
          "statement": {"type": "string"},
          "notes": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "theory_ids": {"type": "array", "items": {"type": "string"}},
          "formal_systems": {"type": "array", "items": {"type": "string"}},
          "regime_dimensions": {"type": "object"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_class": {"type": "string"},
          "last_verified": {"type": "string"},
          "validity_regime": {"type": "string"},
          "uncertainty_kind": {"type": "string"},
          "formalization_status": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "kind": {"enum": ["PROVES", "DEPENDS_ON", "DEFINES", "BRIDGES", "INTERFACE", "LIMITS_TO", "APPROXIMATES", "EMPIRICALLY_CONSTRAINS", "FLOWS_TO", "TRANSFORMS_TO", "BLOCKS"]},
          "status": {"enum": ["ACTIVE", "PROVED", "COMPUTED", "EMPIRICAL", "ASSUMED", "APPROXIMATE", "GAP", "BLOCKED"]},
          "weight": {"type": "number", "minimum": 0},
          "proof_cost": {"type": "number", "minimum": 0},
          "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
          "statement": {"type": "string"},
          "notes": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "theory_ids": {"type": "array", "items": {"type": "string"}},
          "formal_systems": {"type": "array", "items": {"type": "string"}},
          "regime_dimensions": {"type": "object"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_class": {"type": "string"},
          "last_verified": {"type": "string"},
          "validity_regime": {"type": "string"},
          "uncertainty_kind": {"type": "string"},
          "formalization_status": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "epochs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "t"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "t": {"type": "number"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
