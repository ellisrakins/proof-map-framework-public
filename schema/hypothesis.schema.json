{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/proofmap.hypothesis.schema.json",
  "title": "Proof Map Hypothesis Catalog",
  "type": "object",
  "required": ["title", "hypotheses"],
  "properties": {
    "title": {"type": "string"},
    "description": {"type": "string"},
    "metadata": {"type": "object"},
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "description", "target_nodes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "description": {"type": "string"},
          "target_nodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "input_nodes": {"type": "array", "items": {"type": "string"}},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "predictions": {"type": "array", "items": {"type": "string"}},
          "proposed_status": {"enum": ["PROVED", "DERIVED", "COMPUTED", "EMPIRICAL", "PROBABILISTIC", "ASSUMPTION", "APPROXIMATION", "INDEPENDENT"]},
          "proposed_uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
          "complexity": {"type": "number", "minimum": 0},
          "falsifiability": {"type": "number", "minimum": 0, "maximum": 1},
          "prior_plausibility": {"type": "number", "minimum": 0, "maximum": 1},
          "domain": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "last_verified": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
