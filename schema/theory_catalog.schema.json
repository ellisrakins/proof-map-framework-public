{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/proofmap.theory-catalog.schema.json",
  "title": "Proof Map Theory Catalog",
  "type": "object",
  "required": ["title", "version", "scope", "profiles", "relations"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "scope": {"type": "string"},
    "metadata": {"type": "object"},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "maturity",
          "evidence_status",
          "family",
          "summary",
          "domains",
          "foundations",
          "mathematical_frameworks",
          "validity_regimes"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "THEORY",
              "FRAMEWORK",
              "MODEL",
              "EFFECTIVE_THEORY",
              "RESEARCH_PROGRAM",
              "INTERPRETATION"
            ]
          },
          "maturity": {
            "enum": [
              "ESTABLISHED",
              "EFFECTIVE",
              "ACTIVE_RESEARCH",
              "SPECULATIVE",
              "HISTORICAL"
            ]
          },
          "evidence_status": {
            "enum": [
              "PRECISION_TESTED",
              "EMPIRICALLY_SUPPORTED",
              "INDIRECTLY_SUPPORTED",
              "CONSTRAINED",
              "UNCONFIRMED",
              "DISFAVORED",
              "NOT_APPLICABLE"
            ]
          },
          "family": {"type": "string", "minLength": 1},
          "summary": {"type": "string"},
          "domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "foundations": {"type": "array", "items": {"type": "string"}},
          "mathematical_frameworks": {"type": "array", "items": {"type": "string"}},
          "validity_regimes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "description"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "dimensions": {"type": "object"},
                "assumptions": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "key_results": {"type": "array", "items": {"type": "string"}},
          "open_questions": {"type": "array", "items": {"type": "string"}},
          "discriminating_tests": {"type": "array", "items": {"type": "string"}},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "last_verified": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "tags": {"type": "array", "items": {"type": "string"}},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "kind"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "kind": {
            "enum": [
              "EXTENDS",
              "REDUCES_TO",
              "EFFECTIVE_LIMIT_OF",
              "DUAL_TO",
              "COMPATIBLE_WITH",
              "ALTERNATIVE_TO",
              "CONFLICTS_WITH",
              "USES",
              "UNIFIES"
            ]
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "notes": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
